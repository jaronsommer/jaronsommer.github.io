{
  "extraKnownMarketplaces": {
    "claude-code-plugins": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code",
        "sparsePaths": [".claude-plugin", "plugins/frontend-design"]
      }
    }
  },
  "enabledPlugins": {
    "frontend-design@claude-code-plugins": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", ".claude\\readme-reminder.ps1"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
